# Copy to .env.local and fill in from your Supabase dashboard:
#   Project Settings → API Keys
#
# Take the PUBLISHABLE key — `sb_publishable_…`, or the older `anon` JWT.
# Both work. Never the secret / service_role key: it bypasses every policy,
# and anything Vite reads is baked into a bundle that visitors can open.
#
# Vite only exposes variables prefixed VITE_, and only reads them at startup.
# Restart the dev server after changing them; on Vercel, redeploy — editing an
# environment variable does not rebuild on its own.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
