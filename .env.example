# Copy to .env.local and fill in from your Supabase dashboard:
#   Project Settings → API Keys
#
# Use the anon / publishable key, never the service_role / secret key.
# Vite only exposes variables prefixed VITE_, and only reads these at startup —
# restart the dev server after changing them.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
